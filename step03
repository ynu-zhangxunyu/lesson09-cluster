ai指令：groupby('cluster') 输出每簇四特征的均值表；给每簇起业务名（如”高余额低消费稳健型”）；画雷达图或分组柱状图。




# -*- coding: utf-8 -*-
"""
Step 3 — 客户分群画像
tag: O9-step3
产出：画像均值表 + 业务命名 + 雷达图 + 分组柱状图
"""
import os, numpy as np, pandas as pd
import matplotlib; matplotlib.use("Agg")
import matplotlib.pyplot as plt
from sklearn.preprocessing import StandardScaler
from sklearn.cluster import KMeans

# ========== 路径 ==========
BASE  = r"c:\Users\Lucile\Desktop\111"
CSV   = os.path.join(BASE, "bank_customers.csv")
RADAR = os.path.join(BASE, "radar.png")
BAR   = os.path.join(BASE, "cluster_bar.png")

# ========== 数据 & 聚类（与 step01 保持一致）==========
FEATURE_COLS = ["balance", "avg_monthly_spend", "product_count", "overdue_count"]
K = 4   # 最终选定的簇数

df = pd.read_csv(CSV)
X_raw = df[FEATURE_COLS].copy().fillna(df[FEATURE_COLS].median(numeric_only=True))
scaler = StandardScaler()
X_scaled = scaler.fit_transform(X_raw)

kmeans = KMeans(n_clusters=K, random_state=42, n_init=10)
df["cluster"] = kmeans.fit_predict(X_scaled)

# ========== 1) groupby 画像均值表 ==========
profile = df.groupby("cluster")[FEATURE_COLS].mean().round(2)
profile["人数"]    = df["cluster"].value_counts().sort_index()
profile["占比%"]   = (profile["人数"] / len(df) * 100).round(1)
profile.index.name = "簇"

print("=" * 60)
print("              各簇特征画像均值表")
print("=" * 60)
print(profile.to_string())
print("=" * 60)

# ========== 2) 自动 + 手动 业务命名 ==========
# 先打印原始均值，方便人工判定命名
print("\n--- 各簇标准化均值（便于对比高低）---")
z_means = pd.DataFrame(X_scaled).groupby(df["cluster"].values).mean()
z_means.columns = FEATURE_COLS
z_means.index = [f"簇{c}" for c in range(K)]
print(z_means.round(2).to_string())

# 人工根据画像起业务名（来自 step01 实际运行结果）
# 簇0: 高余额 + 中消费 + 少产品 + 低逾期  → 高余额稳健型
# 簇1: 低余额 + 中消费 + 少产品 + 低逾期  → 低余额月光型  
# 簇2: 中余额 + 中消费 + 中产品 + 高逾期  → 高逾期风险型
# 簇3: 中余额 + 中消费 + 多产品 + 低逾期  → 高价值活跃型

CLUSTER_NAMES = {
    0: "高余额稳健型",
    1: "低余额月光型",
    2: "高逾期风险型",
    3: "高价值活跃型",
}
CLUSTER_COLORS = ["#4C72B0", "#DD8452", "#C44E52", "#55A868"]   # 四簇配色

df["segment"] = df["cluster"].map(CLUSTER_NAMES)
profile.index = [f"簇{c} · {CLUSTER_NAMES[c]}" for c in range(K)]

print("\n--- 最终画像表（带业务命名）---")
print(profile.to_string())

# ========== 3) 雷达图（用标准化均值，便于同尺度对比）==========
radar_labels = FEATURE_COLS
angles = np.linspace(0, 2 * np.pi, len(radar_labels), endpoint=False).tolist()
angles += angles[:1]   # 闭合

fig, ax = plt.subplots(figsize=(7, 7), subplot_kw=dict(polar=True))
for c in range(K):
    vals = z_means.iloc[c].tolist()
    vals += vals[:1]
    ax.plot(angles, vals, "o-", lw=2, label=f"簇{c} · {CLUSTER_NAMES[c]}",
            color=CLUSTER_COLORS[c])
    ax.fill(angles, vals, alpha=0.12, color=CLUSTER_COLORS[c])

ax.set_xticks(angles[:-1])
ax.set_xticklabels(radar_labels, fontsize=11)
ax.set_title("客户分群画像雷达图 (标准化均值)", fontsize=13, pad=20)
ax.legend(loc="upper right", bbox_to_anchor=(1.3, 1.1), fontsize=10)
fig.tight_layout()
plt.savefig(RADAR, dpi=150)
print(f"\n[完成] 雷达图 -> {RADAR}")

# ========== 4) 分组柱状图（原尺度均值，更直观）==========
fig, axes = plt.subplots(1, 4, figsize=(14, 5))
for i, col in enumerate(FEATURE_COLS):
    ax = axes[i]
    means = profile[col].values
    bars = ax.bar(range(K), means, color=CLUSTER_COLORS, edgecolor="white")
    ax.set_title(col, fontsize=12, fontweight="bold")
    ax.set_xticks(range(K))
    ax.set_xticklabels([f"簇{c}" for c in range(K)], fontsize=10)
    for b, m in zip(bars, means):
        ax.text(b.get_x() + b.get_width()/2, b.get_height(),
                f"{m:,.0f}" if col != "overdue_count" else f"{m:.1f}",
                ha="center", va="bottom", fontsize=9)

fig.suptitle("各簇特征均值对比（原尺度）", fontsize=14, fontweight="bold")
fig.tight_layout()
plt.savefig(BAR, dpi=150)
print(f"[完成] 分组柱状图 -> {BAR}")

# ========== 5) 画像总结 ==========
print("\n" + "=" * 60)
print("           🌟 四群业务画像一句话总结 🌟")
print("=" * 60)
print(f"""
  💰 簇 0 · 高余额稳健型   ({profile.iloc[0]['占比%']}%)
     特征：余额最高 (平均 {profile.iloc[0]['balance']:,.0f}元)，产品数最少，
           逾期率低 —— 典型的"存得多、用得少、不欠钱"的稳健客户。
     策略：主推理财/大额存单，维持低风险。

  💸 簇 1 · 低余额月光型   ({profile.iloc[1]['占比%']}%)
     特征：余额最低 (平均 {profile.iloc[1]['balance']:,.0f}元)，
           但月消费不低 —— 赚多少花多少的年轻客群。
     策略：推信用卡/消费贷 + 自动转账存款计划，培养储蓄习惯。

  ⚠️ 簇 2 · 高逾期风险型   ({profile.iloc[2]['占比%']}%)
     特征：逾期数最高 (平均 {profile.iloc[2]['overdue_count']:.1f}次)，
           产品数也多 —— 多头借贷、还款能力弱。
     策略：收紧授信额度，推债务重组/分期，加强风控预警。

  ✅ 簇 3 · 高价值活跃型   ({profile.iloc[3]['占比%']}%)
     特征：产品数最多 (平均 {profile.iloc[3]['product_count']:.1f}个)，
           逾期率极低 —— 交叉销售成功、忠诚度高的"金母鸡"。
     策略：升级 VIP 服务、专属权益、私行客户经理。
""")
print("Step 3 分群画像完成 🎯")
